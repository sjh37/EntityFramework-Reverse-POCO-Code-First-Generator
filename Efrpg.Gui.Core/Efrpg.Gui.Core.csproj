<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 is load bearing: this assembly is consumed by the net48 in-process VSIX and by a modern
         test project, and Roslyn ships netstandard2.0 for the same reason. Do not raise it. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Efrpg.Gui</RootNamespace>
    <AssemblyName>Efrpg.Gui.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;ARM64</Platforms>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linked, not copied. This is the template side of the secrets exchange and has to produce byte-identical
         XML to what the efrpg tool parses; a second copy would be free to drift. Compiling the one source file
         into both assemblies is the only way to share it, because Generator is net48 and this is netstandard2.0. -->
    <Compile Include="..\Generator\Readers\SecretsXml.cs" Link="Linked\SecretsXml.cs" />
  </ItemGroup>

</Project>
